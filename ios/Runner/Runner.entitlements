<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (the native button on the sign-in screen). The
	     matching capability must also be ticked on the App ID in the
	     developer portal, or the sheet fails with error 1000. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- Universal Links: taps on sportpadi.com links open the app instead
		     of Safari, for the paths the AASA file lists. `applinks` needs the
		     apex AND www, since either can be shared. -->
		<string>applinks:sportpadi.com</string>
		<string>applinks:www.sportpadi.com</string>
		<!-- Lets iOS offer a password saved for sportpadi.com when signing in
		     to the app. -->
		<string>webcredentials:sportpadi.com</string>
	</array>
</dict>
</plist>
